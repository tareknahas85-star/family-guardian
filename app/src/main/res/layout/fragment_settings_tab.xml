<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Call filtering -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/call_filtering" />

                <RadioGroup android:id="@+id/rgCallMode"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="6dp">
                    <RadioButton android:id="@+id/rbCallOff"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:textSize="15sp"
                        android:textColor="@color/on_surface" android:text="@string/call_off" />
                    <RadioButton android:id="@+id/rbCallUnknown"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:textSize="15sp"
                        android:textColor="@color/on_surface"
                        android:text="@string/call_block_unknown" />
                    <RadioButton android:id="@+id/rbCallWhitelist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:textSize="15sp"
                        android:textColor="@color/on_surface"
                        android:text="@string/call_whitelist" />
                </RadioGroup>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swOutgoing" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/call_outgoing_too" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/always_ring"
                    android:textSize="12sp" android:textColor="@color/on_surface_variant"
                    android:paddingTop="12dp" android:paddingBottom="4dp" />
                <EditText android:id="@+id/etPriorityNumbers"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minLines="2" android:gravity="top|start"
                    android:inputType="textMultiLine|phone"
                    android:background="@color/surface_container_low" android:padding="10dp"
                    android:textSize="14sp" android:textColor="@color/on_surface"
                    android:hint="@string/one_number_per_line"
                    android:importantForAutofill="no" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/also_allowed" android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:paddingTop="10dp" android:paddingBottom="4dp" />
                <EditText android:id="@+id/etAllowedNumbers"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minLines="2" android:gravity="top|start"
                    android:inputType="textMultiLine|phone"
                    android:background="@color/surface_container_low" android:padding="10dp"
                    android:textSize="14sp" android:textColor="@color/on_surface"
                    android:importantForAutofill="no" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/always_blocked" android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:paddingTop="10dp" android:paddingBottom="4dp" />
                <EditText android:id="@+id/etBlockedNumbers"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minLines="2" android:gravity="top|start"
                    android:inputType="textMultiLine|phone"
                    android:background="@color/surface_container_low" android:padding="10dp"
                    android:textSize="14sp" android:textColor="@color/on_surface"
                    android:importantForAutofill="no" />

                <Button android:id="@+id/btnSaveNumbers" style="@style/Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/save_numbers" android:layout_marginTop="12dp" />

                <TextView android:id="@+id/tvCallHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="12sp"
                    android:textColor="@color/secondary_dark" android:paddingTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Internet and content -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/restrictions" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swInternet" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/internet_paused" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swFilterWeb" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/safe_browsing" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/safe_browsing_hint" android:paddingBottom="6dp"
                    android:textSize="12sp" android:textColor="@color/on_surface_variant" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swCamera" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/disable_camera" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swSos" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/sos_on_child" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swWeekly" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/weekly_report" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swFeed" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/record_feed" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/record_feed_hint"
                    android:textSize="12sp" android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Daily screen time budget -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Text.SectionLabel" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/daily_limit" />
                    <TextView android:id="@+id/tvLimitValue" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="@color/primary" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/sliderLimit"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:valueFrom="0" android:valueTo="480" android:stepSize="15"
                    android:layout_marginTop="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView style="@style/Text.Caption" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/off" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/fmt_8h" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swLockAtLimit" style="@style/Switch.Guardian"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/lock_at_limit" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Installed apps manager -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/apps_on_child" />
                <EditText android:id="@+id/etAppSearch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/search_apps" android:inputType="text" android:maxLines="1"
                    android:background="@color/surface_container_low" android:padding="12dp"
                    android:textSize="14sp" android:textColor="@color/on_surface"
                    android:layout_marginTop="10dp" android:importantForAutofill="no" />
                <TextView android:id="@+id/tvAppsHint" style="@style/Text.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="8dp" />
                <LinearLayout android:id="@+id/appsHost"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Notifications -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/alerts" />
                <TextView android:id="@+id/tvNotifState" style="@style/Text.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:paddingTop="8dp" />
                <Button android:id="@+id/btnNotifSettings" style="@style/Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/notification_settings" android:layout_marginTop="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Rewards: tasks the child can complete to earn screen time -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/rewards_title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/rewards_hint" android:paddingTop="4dp"
                    android:textSize="12sp" android:textColor="@color/on_surface_variant" />
                <LinearLayout android:id="@+id/tasksHost" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingTop="6dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <EditText android:id="@+id/etTaskTitle" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:hint="@string/task_title_hint" android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:background="@color/surface_container_low" android:padding="10dp"
                        android:textSize="14sp" android:textColor="@color/on_surface"
                        android:importantForAutofill="no" />
                    <EditText android:id="@+id/etTaskMinutes" android:layout_width="90dp"
                        android:layout_height="wrap_content" android:hint="@string/task_minutes_hint"
                        android:inputType="number" android:text="15" android:maxLines="1"
                        android:background="@color/surface_container_low" android:padding="10dp"
                        android:layout_marginStart="8dp" android:textSize="14sp"
                        android:textColor="@color/on_surface" android:importantForAutofill="no" />
                </LinearLayout>
                <Button android:id="@+id/btnAddTask" style="@style/Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/add_task" android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Another parent -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/second_parent_title" />
                <TextView android:id="@+id/tvSecondParent" style="@style/Text.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:paddingTop="6dp" />
                <Button android:id="@+id/btnInviteParent" style="@style/Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/invite_parent" android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Safe zones and time rules, moved here from the old separate screen -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/safe_zones" />
                <TextView android:id="@+id/tvZonesList" style="@style/Text.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:paddingTop="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <EditText android:id="@+id/etZoneName" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:hint="@string/name" android:inputType="text" android:maxLines="1"
                        android:background="@color/surface_container_low" android:padding="10dp"
                        android:textSize="14sp" android:textColor="@color/on_surface"
                        android:importantForAutofill="no" />
                    <EditText android:id="@+id/etZoneRadius" android:layout_width="90dp"
                        android:layout_height="wrap_content" android:hint="@string/unit_m"
                        android:inputType="number" android:text="200" android:maxLines="1"
                        android:background="@color/surface_container_low" android:padding="10dp"
                        android:layout_marginStart="8dp" android:textSize="14sp"
                        android:textColor="@color/on_surface" android:importantForAutofill="no" />
                </LinearLayout>
                <Button android:id="@+id/btnAddZone" style="@style/Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/add_zone_here" android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnClearZones" style="@style/Button.Danger"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/remove_all_zones" android:layout_marginTop="6dp" />

                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/time_rules"
                    android:paddingTop="18dp" />
                <TextView android:id="@+id/tvRulesList" style="@style/Text.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:paddingTop="8dp" />
                <Button android:id="@+id/btnAddBedtime" style="@style/Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/add_bedtime" android:layout_marginTop="8dp" />
                <Button android:id="@+id/btnAddStudy" style="@style/Button.Outline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/add_study" android:layout_marginTop="6dp" />
                <Button android:id="@+id/btnClearRules" style="@style/Button.Danger"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/remove_all_rules" android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Language -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/language" />
                <RadioGroup android:id="@+id/rgLang" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:paddingTop="8dp">
                    <RadioButton android:id="@+id/rbLangSystem" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/lang_system" android:textSize="14sp"
                        android:textColor="@color/on_surface" />
                    <RadioButton android:id="@+id/rbLangEn" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/lang_en" android:textSize="14sp"
                        android:textColor="@color/on_surface" />
                    <RadioButton android:id="@+id/rbLangAr" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/lang_ar" android:textSize="14sp"
                        android:textColor="@color/on_surface" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btnAbout" style="@style/Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/about" />
    </LinearLayout>
</ScrollView>
