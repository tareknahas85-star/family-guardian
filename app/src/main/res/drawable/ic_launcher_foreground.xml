<?xml version="1.0" encoding="utf-8"?>
<!--
    Vector version of the app icon (white house with an amber heart on teal).
    Canvas: 108×108 dp. Used as the SOS widget preview image; the launcher icon
    itself uses the PNGs in mipmap-* (same artwork).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Teal disc so the preview reads on light and dark backgrounds -->
    <path
        android:fillColor="#00897B"
        android:pathData="M54,18 A36,36 0 1,1 53.99,18 Z" />

    <!-- House -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M54,27 L83,53 L76,53 L76,79 Q76,81 74,81 L34,81 Q32,81 32,79 L32,53 L25,53 Z" />

    <!-- Heart -->
    <path
        android:fillColor="#F9A825"
        android:pathData="M54,74 C54,74 41.5,66.5 41.5,59 C41.5,55.2 44.4,52.3 48,52.3 C50.6,52.3 52.7,53.8 54,56 C55.3,53.8 57.4,52.3 60,52.3 C63.6,52.3 66.5,55.2 66.5,59 C66.5,66.5 54,74 54,74 Z" />
</vector>
