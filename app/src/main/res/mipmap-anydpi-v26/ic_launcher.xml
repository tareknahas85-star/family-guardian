<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive Icon — API 26+
     foreground = mipmap/ic_launcher_foreground.png  (real PNG, one per density, full resolution)
     background = brand teal (#00897B); foreground = white house with an amber heart
     Legacy launchers (API < 26) fall back to mipmap-*/ic_launcher.png
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
